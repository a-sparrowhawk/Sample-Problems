##################################################################################

#setting up the question

INPUT_SIZE = 4 #pass in a element of size 4

#sizes of the layers 
H1_SIZE = 5 #hidden layer
H2_SIZE = 3 #this is the output layer

LEARN_RATE = 0.1 #in the gradient descent, we are looking for the next point =  previous point + learning rate * gradient vector

X = np.array([[0, 0, 1, 0], [1, 0, 0, 1], [0, 1, 0, 1], [0, 1, 1, 1]])
Y = np.array([[1, 0, 0], [0, 1, 0], [0, 0, 1], [1, 0, 1]])

###################################################################################

#implementing the forward propagation

def initialize_weights():
    #create these matrices 
    w1 = np.random.randn(INPUT_SIZE, H1_SIZE)
    w2 = np.random.randn(H1_SIZE, H2_SIZE)
    b1 = np.random.randn(1, H1_SIZE)
    b2 = np.random.randn(1, H2_SIZE) 
    #print(np.shape(w1), np.shape(b1), np.shape(w2), np.shape(b2))
    return(w1, b1, w2, b2)


def sigmoid(z):
    #z is a vector
    sigmoid = 1 / (1 + np.exp(-z))
    return(sigmoid)


#need: forward function that accepts input (what we plug into system, w1, b1, w2, b2)

def forward(x_vec, w1, b1, w2, b2):
    #every time we run our code, we will get new weight matrices
    z1 = np.dot(x_vec, w1) + b1 #x_vec is only the initial layer 
    a1 = sigmoid(z1)
    
    z2 = np.dot(a1, w2) + b2 #the input to the next layer is the previous layer, which is a1
    a2 = sigmoid(z2)
    
    return(a1, a2)


def run(): #main entry point
    #get our matrices 
    w1, b1, w2, b2 = initialize_weights()
    a1, a2 = forward(X, w1, b1, w2, b2) #we do not care about the first layer so we can put an underscore there. this is called curing
