############################################################

#loss function

def loss(y_true, y_pred):
    avg_loss = np.mean((y_true - y_pred)**2)
    return(avg_loss)


#############################################################

#implementing the back propagation

def sigmoid_derivative(var):
    der = sigmoid(var)*(1 - sigmoid(var))
    return(der)


def back_prop(input, y_true, a1, a2, w1, b1, w2, b2):
    #we need to pass the middle layers since they are all vectors 
    #we need to constantly pass our weights and biases since they are always changing
    error2 = y_true - a2
    delta2 = error2 * sigmoid_derivative(a2)
    error1 = np.dot(delta2, w2.T)
    delta1 = error1 * sigmoid_derivative(a1)
    
    #we are computing how the errors propagate through the layers 
    dw2 = np.dot(a1.T, delta2)
    db2 = np.sum(delta2, axis = 0, keepdims = True)
    dw1 = np.dot(input.T, delta1)
    db1 = np.sum(delta1, axis = 0, keepdims = True)
    
    #implementing gradient descent 
    w2_new = w2 +  LEARN_RATE*dw2
    b2_new = b2 + LEARN_RATE*db2
    w1_new = w1 + LEARN_RATE*dw1
    b1_new = b1 + LEARN_RATE*db1

    return(w1_new, b1_new, w2_new, b2_new)

###########################################################

#training function 
def train(epochs):
    #the input that is coming in is all of the input 
    w1, b1, w2, b2 = initialize_weights()
    for e in range(epochs):
        a1, a2 = forward(X, w1, b1, w2, b2)
        l = loss(Y, a2)
        #print(l)
        w1, b1, w2, b2 = back_prop(X, Y, a1, a2, w1, b1, w2, b2)
    return(w1, b1, w2, b2)
    
###########################################################


print('\n')
run()
